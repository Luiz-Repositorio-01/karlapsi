# =============================================================================
# Karla Neuropsi — variáveis de ambiente
#
# Copie para `.env.local` (desenvolvimento) ou configure no painel do provedor
# de hospedagem (produção). NUNCA faça commit de valores reais: `.env*` está no
# .gitignore, exceto este arquivo de exemplo.
#
# Regra de ouro: variáveis com prefixo NEXT_PUBLIC_ vão para o navegador.
# Só coloque nelas informação que pode ser pública.
# =============================================================================

# -----------------------------------------------------------------------------
# SITE (obrigatório em produção)
# -----------------------------------------------------------------------------
# URL canônica, usada em metadata, sitemap, links de e-mail e retorno do
# checkout. Sem barra no final.
NEXT_PUBLIC_SITE_URL=https://karlaneuropsi.com.br

# -----------------------------------------------------------------------------
# SUPABASE (obrigatório: banco, autenticação e storage)
# Onde encontrar: painel do Supabase → Project Settings → API
# -----------------------------------------------------------------------------
# URL do projeto (pública por definição).
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima (pública). Toda a proteção vem das políticas de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SEGREDO — ignora RLS. Usado somente no servidor (webhook de pagamento,
# conciliação e fila de notificações). Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# MERCADO PAGO (opcional — necessário só para venda de materiais)
# Onde encontrar: painel do Mercado Pago → Suas integrações → Credenciais
# -----------------------------------------------------------------------------
# SEGREDO — access token de produção. Fica apenas no servidor.
MERCADOPAGO_ACCESS_TOKEN=
# Chave pública (usada apenas se você adotar o Checkout Bricks no futuro).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# SEGREDO — assinatura do webhook (painel → Webhooks → "Chave secreta").
# Sem ela, o webhook não confia no payload e consulta a API antes de gravar.
MERCADOPAGO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# E-MAIL TRANSACIONAL (opcional — confirmações e avisos)
# -----------------------------------------------------------------------------
# Provedores suportados: resend | brevo | log
# `log` apenas registra o assunto no log do servidor (uso em desenvolvimento).
EMAIL_PROVIDER=log
# SEGREDO — chave da API do provedor.
EMAIL_API_KEY=
# Remetente verificado no provedor (ex.: contato@karlaneuropsi.com.br).
EMAIL_FROM=
# Endereço interno que recebe os avisos da equipe.
EMAIL_INTERNAL_RECIPIENT=

# -----------------------------------------------------------------------------
# WHATSAPP
# -----------------------------------------------------------------------------
# Número público do botão "Falar pelo WhatsApp" (não é credencial).
# Formato: código do país + DDD + número, só dígitos.
NEXT_PUBLIC_WHATSAPP=5511988830377
# SEGREDOS — apenas para envio automático via WhatsApp Cloud API (opcional).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# TAREFAS AGENDADAS (opcional)
# -----------------------------------------------------------------------------
# SEGREDO — protege POST /api/notifications/dispatch, que processa a fila de
# e-mails. Sem esta variável o endpoint responde 503 e nada é enviado.
# Gere com: openssl rand -hex 32
CRON_SECRET=
